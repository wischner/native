{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Linux X11, Xephyr",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/linux-x11/src/vision",
            "cwd": "${workspaceFolder}",
            "environment": [
                {"name": "ASAN_OPTIONS", "value": "detect_leaks=0"}
            ],
            "stopAtEntry": false,
            "MIMode": "gdb",
            "externalConsole": false,
            "pipeTransport": {
                "pipeCwd": "${workspaceFolder}",
                "pipeProgram": "/bin/bash",
                "pipeArgs": ["${workspaceFolder}/scripts/linux/x11/run-twm.sh"],
                "debuggerPath": "/usr/bin/gdb"
            },
            "preLaunchTask": "CMake Build Debug (Docker X11)"
        },
        {
            "name": "Linux SDL2, local",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/linux-sdl2/src/vision",
            "cwd": "${workspaceFolder}",
            "stopAtEntry": false,
            "MIMode": "gdb",
            "externalConsole": false,
            "pipeTransport": {
                "pipeCwd": "${workspaceFolder}",
                "pipeProgram": "${workspaceFolder}/scripts/linux/docker-debug.sh",
                "pipeArgs": ["wischner/gcc-x86_64-linux-sdl:latest"],
                "debuggerPath": "/usr/bin/gdb"
            },
            "preLaunchTask": "CMake Build Debug (Docker SDL2)"
        },
        {
            "name": "Linux OPEN LOOK, Xephyr",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/linux-openlook/src/vision",
            "cwd": "${workspaceFolder}",
            "stopAtEntry": false,
            "MIMode": "gdb",
            "externalConsole": false,
            "environment": [
                {
                    "name": "ASAN_OPTIONS",
                    "value": "detect_leaks=0"
                }
            ],
            "pipeTransport": {
                "pipeCwd": "${workspaceFolder}",
                "pipeProgram": "${workspaceFolder}/scripts/linux/docker-debug.sh",
                "pipeArgs": [
                    "--session",
                    "openlook-xephyr",
                    "wischner/gcc-x86_64-linux-openlook:latest"
                ],
                "debuggerPath": "/usr/bin/gdb"
            },
            "preLaunchTask": "CMake Build Debug (Docker OpenLook)"
        },
        {
            "name": "Linux Window Maker, Xephyr",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/linux-wmaker/src/vision",
            "cwd": "${workspaceFolder}",
            "stopAtEntry": false,
            "MIMode": "gdb",
            "externalConsole": false,
            "environment": [
                {
                    "name": "ASAN_OPTIONS",
                    "value": "detect_leaks=0"
                }
            ],
            "pipeTransport": {
                "pipeCwd": "${workspaceFolder}",
                "pipeProgram": "${workspaceFolder}/scripts/linux/docker-debug.sh",
                "pipeArgs": [
                    "--session",
                    "window-maker-xephyr",
                    "wischner/gcc-x86_64-linux-window-maker:latest"
                ],
                "debuggerPath": "/usr/bin/gdb"
            },
            "preLaunchTask": "CMake Build Debug (Docker Window Maker)"
        },
        {
            "name": "GEM, Rasta@SDL2",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/linux-gemix-gemd/src/vision",
            "cwd": "${workspaceFolder}",
            "stopAtEntry": false,
            "MIMode": "gdb",
            "externalConsole": false,
            "environment": [
                {"name": "ASAN_OPTIONS", "value": "detect_leaks=0"}
            ],
            "pipeTransport": {
                "pipeCwd": "${workspaceFolder}",
                "pipeProgram": "${workspaceFolder}/scripts/gemix/debug-pipe.sh",
                "pipeArgs": ["wischner/gcc-x86_64-gemix:latest"],
                "debuggerPath": "/usr/bin/gdb"
            },
            "preLaunchTask": "CMake Build Debug (GEM, Rasta@SDL2)"
        },
        {
            "name": "Linux Motif/CDE, Xephyr",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/linux-openmotif/src/vision",
            "cwd": "${workspaceFolder}",
            "stopAtEntry": false,
            "MIMode": "gdb",
            "externalConsole": false,
            "environment": [
                {
                    "name": "ASAN_OPTIONS",
                    "value": "detect_leaks=0"
                }
            ],
            "pipeTransport": {
                "pipeCwd": "${workspaceFolder}",
                "pipeProgram": "${workspaceFolder}/scripts/linux/docker-debug.sh",
                "pipeArgs": [
                    "--session",
                    "cde-xephyr",
                    "wischner/gcc-x86_64-linux-motif:latest"
                ],
                "debuggerPath": "/usr/bin/gdb"
            },
            "preLaunchTask": "CMake Build Debug (Docker OpenMotif)"
        },
        {
            "name": "Debug Vision (Windows 11 VM)",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/windows-mingw-w64/src/vision.exe",
            "cwd": "${workspaceFolder}/build/windows-mingw-w64/src",
            "stopAtEntry": false,
            "MIMode": "gdb",
            "miDebuggerPath": "${workspaceFolder}/scripts/windows/vm/debug-pipe.sh",
            "miDebuggerServerAddress": "127.0.0.1:31337",
            "setupCommands": [
                {"text": "-gdb-set mi-async on", "ignoreFailures": false}
            ],
            "targetArchitecture": "x64",
            "sourceFileMap": {
                "/": {"editorPath": "/", "useForBreakpoints": true}
            },
            "launchCompleteCommand": "exec-continue",
            "externalConsole": false,
            "preLaunchTask": "Deploy Vision Debug (Windows VM)",
            "postDebugTask": "Stop Vision Debug (Windows VM)"
        },
        {
            "name": "Haiku, VM",
            "type": "cppdbg",
            "request": "launch",
            "program": "/boot/home/Projects/${workspaceFolderBasename}/run/vision",
            "cwd": "/boot/home/Projects/${workspaceFolderBasename}/run",
            "environment": [
                {"name": "GALLIUM_DRIVER", "value": "softpipe"}
            ],
            "stopAtEntry": false,
            "MIMode": "gdb",
            "externalConsole": false,
            "sourceFileMap": {
                "/home/tstih/data/wischner/native": "${workspaceFolder}"
            },
            "pipeTransport": {
                "pipeProgram": "ssh",
                "pipeArgs": ["-T", "haiku"],
                "debuggerPath": "/boot/system/bin/gdb"
            },
            "preLaunchTask": "Deploy Vision Debug (Haiku)"
        },
        {
            "name": "Debug Vision (macOS leia, LLDB)",
            "type": "node-terminal",
            "request": "launch",
            "command": "exec \"${workspaceFolder}/scripts/macos/remote/debug.sh\"",
            "cwd": "${workspaceFolder}",
            "preLaunchTask": "Build Vision Debug (macOS leia)"
        }
    ]
}
