{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "CMake Configure Debug (Docker Targets)",
            "type": "shell",
            "command": "cmake",
            "args": [
                "-S",
                ".",
                "-B",
                "build/cmake",
                "-G",
                "Unix Makefiles",
                "-DCMAKE_BUILD_TYPE=Debug"
            ],
            "problemMatcher": [],
            "group": "build"
        },
        {
            "label": "CMake Build Debug (Docker GEMix)",
            "type": "shell",
            "command": "cmake",
            "args": ["--build", "build/cmake", "--target", "docker-gemix"],
            "problemMatcher": "$gcc",
            "group": "build",
            "dependsOn": "CMake Configure Debug (Docker Targets)"
        },
        {
            "label": "CMake Build Debug (Docker X11)",
            "type": "shell",
            "command": "cmake",
            "args": ["--build", "build/cmake", "--target", "docker-x11"],
            "problemMatcher": "$gcc",
            "group": "build",
            "dependsOn": "CMake Configure Debug (Docker Targets)"
        },
        {
            "label": "CMake Build Debug (Docker SDL2)",
            "type": "shell",
            "command": "cmake",
            "args": ["--build", "build/cmake", "--target", "docker-sdl2"],
            "problemMatcher": "$gcc",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "dependsOn": "CMake Configure Debug (Docker Targets)"
        },
        {
            "label": "CMake Build Debug (Docker OpenMotif)",
            "type": "shell",
            "command": "cmake",
            "args": [
                "--build",
                "build/cmake",
                "--target",
                "docker-openmotif"
            ],
            "problemMatcher": "$gcc",
            "group": "build",
            "dependsOn": "CMake Configure Debug (Docker Targets)"
        },
        {
            "label": "CMake Build Debug (Docker OpenLook)",
            "type": "shell",
            "command": "cmake",
            "args": [
                "--build",
                "build/cmake",
                "--target",
                "docker-openlook"
            ],
            "problemMatcher": "$gcc",
            "group": "build",
            "dependsOn": "CMake Configure Debug (Docker Targets)"
        },
        {
            "label": "CMake Build Debug (Docker Window Maker)",
            "type": "shell",
            "command": "cmake",
            "args": [
                "--build",
                "build/cmake",
                "--target",
                "docker-wmaker"
            ],
            "problemMatcher": "$gcc",
            "group": "build",
            "dependsOn": "CMake Configure Debug (Docker Targets)"
        },
        {
            "label": "CMake Build Debug (Docker Windows)",
            "type": "shell",
            "command": "cmake",
            "args": ["--build", "build/cmake", "--target", "docker-win"],
            "problemMatcher": "$gcc",
            "group": "build",
            "dependsOn": "CMake Configure Debug (Docker Targets)"
        },
        {
            "label": "CMake Build Debug (Docker Haiku)",
            "type": "shell",
            "command": "cmake",
            "args": ["--build", "build/cmake", "--target", "docker-haiku"],
            "problemMatcher": "$gcc",
            "group": "build",
            "dependsOn": "CMake Configure Debug (Docker Targets)"
        },
        {
            "label": "Prepare Vision Debug Runtime (Wine DLLs)",
            "type": "shell",
            "command": "bash",
            "args": [
                "-lc",
                "docker run --rm -u \"$(id -u):$(id -g)\" -v \"${workspaceFolder}:/src\" -w /src wischner/gcc-x86_64-windows-mingw-w64 cp -f /usr/lib/gcc/x86_64-w64-mingw32/10-posix/libgcc_s_seh-1.dll /usr/lib/gcc/x86_64-w64-mingw32/10-posix/libstdc++-6.dll /usr/x86_64-w64-mingw32/lib/libwinpthread-1.dll build/windows-mingw-w64/src/"
            ],
            "problemMatcher": [],
            "dependsOn": "CMake Build Debug (Docker Windows)"
        },
        {
            "label": "Start Vision Debug Server (Wine)",
            "type": "process",
            "command": "${workspaceFolder}/scripts/windows/wine-debug-server.sh",
            "args": [
                "${workspaceFolder}/build/windows-mingw-w64/src/vision.exe",
                "31337"
            ],
            "isBackground": true,
            "problemMatcher": {
                "owner": "wine",
                "pattern": {
                    "regexp": "^(?!)$"
                },
                "background": {
                    "activeOnStart": true,
                    "beginsPattern": "^Starting Wine GDB proxy .*$",
                    "endsPattern": "^Wine GDB proxy ready at localhost:31337\\.$"
                }
            },
            "dependsOn": "Prepare Vision Debug Runtime (Wine DLLs)"
        },
        {
            "label": "Start Debug Target (Tribblix CDE)",
            "type": "process",
            "command": "${workspaceFolder}/scripts/kvm/ensure-running.sh",
            "args": ["Tribblix-CDE", "tomaz@charlie"],
            "problemMatcher": []
        },
        {
            "label": "Sync Source (OpenMotif Tribblix CDE)",
            "type": "shell",
            "command": "rsync",
            "args": [
                "-az",
                "--delete",
                "--exclude",
                ".git",
                "--exclude",
                "build",
                "${workspaceFolder}/",
                "tomaz@charlie:~/Projects/${workspaceFolderBasename}/"
            ],
            "problemMatcher": [],
            "dependsOn": "Start Debug Target (Tribblix CDE)"
        },
        {
            "label": "Build Vision Debug (OpenMotif Tribblix CDE)",
            "type": "process",
            "command": "ssh",
            "args": [
                "tomaz@charlie",
                "cd $HOME/Projects/${workspaceFolderBasename} && PKG_CONFIG_PATH=/usr/lib/amd64/pkgconfig cmake -S . -B build/tribblix-openmotif-debug -DCMAKE_BUILD_TYPE=Debug -DTOOLKIT=MOTIF -DNATIVE_ENABLE_DEVELOPER_CHECKS=OFF -DCMAKE_CXX_FLAGS='-m64 -Wall -Wextra -pedantic' -DCMAKE_EXE_LINKER_FLAGS=-m64 -DCMAKE_LIBRARY_PATH=/usr/lib/amd64 && cmake --build build/tribblix-openmotif-debug"
            ],
            "problemMatcher": "$gcc",
            "dependsOn": "Sync Source (OpenMotif Tribblix CDE)"
        },
        {
            "label": "Start Debug Target (Haiku)",
            "type": "process",
            "command": "${workspaceFolder}/scripts/kvm/ensure-running.sh",
            "args": ["Haiku", "user@192.168.122.90"],
            "problemMatcher": []
        },
        {
            "label": "Prepare Vision Debug Directory (Haiku)",
            "type": "shell",
            "command": "ssh",
            "args": [
                "user@192.168.122.90",
                "mkdir -p /boot/home/Projects/${workspaceFolderBasename}/run"
            ],
            "problemMatcher": [],
            "dependsOn": "Start Debug Target (Haiku)"
        },
        {
            "label": "Deploy Vision Debug (Haiku)",
            "type": "shell",
            "command": "scp",
            "args": [
                "${workspaceFolder}/build/haiku/src/vision",
                "user@192.168.122.90:/boot/home/Projects/${workspaceFolderBasename}/run/vision"
            ],
            "problemMatcher": [],
            "dependsOrder": "sequence",
            "dependsOn": [
                "CMake Build Debug (Docker Haiku)",
                "Prepare Vision Debug Directory (Haiku)"
            ]
        },
        {
            "label": "Build Vision Debug (macOS leia)",
            "type": "process",
            "command": "${workspaceFolder}/scripts/macos/remote/build.sh",
            "problemMatcher": "$gcc"
        },
        {
            "label": "Smoke Test Vision Debug (macOS leia)",
            "type": "process",
            "command": "${workspaceFolder}/scripts/macos/remote/smoke-test.sh",
            "problemMatcher": [],
            "dependsOn": "Build Vision Debug (macOS leia)"
        }
    ]
}
