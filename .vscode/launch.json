{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug Vision (Linux X11, Xephyr/TWM mono)",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/linux-x11/src/vision",
            "cwd": "${workspaceFolder}",
            "environment": [
                {"name": "ASAN_OPTIONS", "value": "detect_leaks=0"}
            ],
            "stopAtEntry": false,
            "MIMode": "gdb",
            "externalConsole": false,
            "pipeTransport": {
                "pipeCwd": "${workspaceFolder}",
                "pipeProgram": "/bin/bash",
                "pipeArgs": ["${workspaceFolder}/scripts/linux/x11/run-twm.sh"],
                "debuggerPath": "/usr/bin/gdb"
            },
            "preLaunchTask": "CMake Build Debug (Docker X11)"
        },
        {
            "name": "Debug Vision (Linux SDL2, local)",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/linux-sdl2/src/vision",
            "cwd": "${workspaceFolder}",
            "stopAtEntry": false,
            "MIMode": "gdb",
            "externalConsole": false,
            "pipeTransport": {
                "pipeCwd": "${workspaceFolder}",
                "pipeProgram": "${workspaceFolder}/scripts/linux/docker-debug.sh",
                "pipeArgs": ["wischner/gcc-x86_64-linux-sdl:latest"],
                "debuggerPath": "/usr/bin/gdb"
            },
            "preLaunchTask": "CMake Build Debug (Docker SDL2)"
        },
        {
            "name": "Debug Vision (OPEN LOOK, Tribblix VM)",
            "type": "cppdbg",
            "request": "launch",
            "program": "/export/home/tomaz/Projects/${workspaceFolderBasename}/build/tribblix-openlook-debug/src/vision",
            "cwd": "/export/home/tomaz/Projects/${workspaceFolderBasename}",
            "stopAtEntry": false,
            "MIMode": "gdb",
            "externalConsole": false,
            "environment": [
                {"name": "DISPLAY", "value": ":0"},
                {"name": "XAUTHORITY", "value": "/export/home/tomaz/.Xauthority"}
            ],
            "sourceFileMap": {
                "/export/home/tomaz/Projects/native": "${workspaceFolder}"
            },
            "pipeTransport": {
                "pipeProgram": "ssh",
                "pipeArgs": ["-T", "tomaz@192.168.122.28"],
                "debuggerPath": "/usr/bin/amd64/gdb"
            },
            "preLaunchTask": "Build Vision Debug (OPEN LOOK Tribblix VM)"
        },
        {
            "name": "Debug Vision (Window Maker, Bookworm VM)",
            "type": "cppdbg",
            "request": "launch",
            "program": "/home/tomaz/Projects/${workspaceFolderBasename}/build/bookworm-wmaker-debug/src/vision",
            "cwd": "/home/tomaz/Projects/${workspaceFolderBasename}",
            "stopAtEntry": false,
            "MIMode": "gdb",
            "externalConsole": false,
            "environment": [
                {"name": "DISPLAY", "value": ":0"},
                {"name": "XAUTHORITY", "value": "/home/tomaz/.Xauthority"},
                {"name": "ASAN_OPTIONS", "value": "detect_leaks=0"}
            ],
            "sourceFileMap": {
                "/home/tomaz/Projects/native": "${workspaceFolder}"
            },
            "pipeTransport": {
                "pipeProgram": "ssh",
                "pipeArgs": ["-T", "whiskey"],
                "debuggerPath": "/usr/bin/gdb"
            },
            "preLaunchTask": "Build Vision Debug (Window Maker Bookworm VM)"
        },
        {
            "name": "Debug Vision (Linux GEMix, local)",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/linux-gemix/src/vision",
            "cwd": "${workspaceFolder}",
            "stopAtEntry": false,
            "MIMode": "gdb",
            "externalConsole": false,
            "environment": [
                {"name": "GEM_VDI_WIDTH", "value": "904"},
                {"name": "GEM_VDI_HEIGHT", "value": "900"},
                {"name": "GEM_RASTA_FRAMEBUFFER", "value": "/tmp/rasta.fb"},
                {"name": "GEM_RASTA_HOST", "value": "127.0.0.1"},
                {"name": "GEM_RASTA_PORT", "value": "5000"},
                {"name": "GEM_RASTA_SCALE", "value": "1"},
                {"name": "GEM_RASTA_CURSOR", "value": "off"},
                {"name": "GEM_RASTA_INVERSE", "value": "on"},
                {"name": "LD_PRELOAD", "value": "/usr/lib/gcc/x86_64-linux-gnu/11/libasan.so:/usr/lib/gcc/x86_64-linux-gnu/11/libubsan.so"},
                {"name": "ASAN_OPTIONS", "value": "detect_leaks=0"}
            ],
            "pipeTransport": {
                "pipeCwd": "${workspaceFolder}",
                "pipeProgram": "${workspaceFolder}/scripts/gemix/debug-pipe.sh",
                "pipeArgs": ["wischner/gcc-x86_64-gemix:gem-v1.0.0"],
                "debuggerPath": "/usr/bin/gdb"
            },
            "preLaunchTask": "CMake Build Debug (Docker GEMix)"
        },
        {
            "name": "Debug Vision (Linux GEMix, gemd proxy)",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/linux-gemix-gemd/src/vision",
            "cwd": "${workspaceFolder}",
            "stopAtEntry": false,
            "MIMode": "gdb",
            "externalConsole": false,
            "environment": [
                {"name": "ASAN_OPTIONS", "value": "detect_leaks=0"}
            ],
            "pipeTransport": {
                "pipeCwd": "${workspaceFolder}",
                "pipeProgram": "${workspaceFolder}/scripts/gemix/debug-pipe.sh",
                "pipeArgs": ["wischner/gcc-x86_64-gemix:gem-v1.0.0", "--gemd"],
                "debuggerPath": "/usr/bin/gdb"
            },
            "preLaunchTask": "CMake Build Debug (Docker GEMix gemd)"
        },
        {
            "name": "Debug Vision (OpenMotif, Tribblix CDE VM)",
            "type": "cppdbg",
            "request": "launch",
            "program": "/export/home/tomaz/Projects/${workspaceFolderBasename}/build/tribblix-openmotif-debug/src/vision",
            "cwd": "/export/home/tomaz/Projects/${workspaceFolderBasename}",
            "stopAtEntry": false,
            "MIMode": "gdb",
            "externalConsole": false,
            "environment": [
                {"name": "DISPLAY", "value": ":0"}
            ],
            "sourceFileMap": {
                "/export/home/tomaz/Projects/native": "${workspaceFolder}"
            },
            "pipeTransport": {
                "pipeProgram": "ssh",
                "pipeArgs": ["-T", "tomaz@charlie"],
                "debuggerPath": "/usr/bin/amd64/gdb"
            },
            "preLaunchTask": "Build Vision Debug (OpenMotif Tribblix CDE)"
        },
        {
            "name": "Debug Vision (Windows 11 VM)",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/windows-mingw-w64/src/vision.exe",
            "cwd": "${workspaceFolder}/build/windows-mingw-w64/src",
            "stopAtEntry": false,
            "MIMode": "gdb",
            "miDebuggerPath": "${workspaceFolder}/scripts/windows/vm/debug-pipe.sh",
            "miDebuggerServerAddress": "127.0.0.1:31337",
            "setupCommands": [
                {"text": "-gdb-set mi-async on", "ignoreFailures": false}
            ],
            "targetArchitecture": "x64",
            "sourceFileMap": {
                "/": {"editorPath": "/", "useForBreakpoints": true}
            },
            "launchCompleteCommand": "exec-continue",
            "externalConsole": false,
            "preLaunchTask": "Deploy Vision Debug (Windows VM)",
            "postDebugTask": "Stop Vision Debug (Windows VM)"
        },
        {
            "name": "Debug Vision (Haiku VM)",
            "type": "cppdbg",
            "request": "launch",
            "program": "/boot/home/Projects/${workspaceFolderBasename}/run/vision",
            "cwd": "/boot/home/Projects/${workspaceFolderBasename}/run",
            "stopAtEntry": false,
            "MIMode": "gdb",
            "externalConsole": false,
            "sourceFileMap": {
                "/home/tstih/data/wischner/native": "${workspaceFolder}"
            },
            "pipeTransport": {
                "pipeProgram": "ssh",
                "pipeArgs": ["-T", "user@192.168.122.90"],
                "debuggerPath": "/boot/system/bin/gdb"
            },
            "preLaunchTask": "Deploy Vision Debug (Haiku)"
        },
        {
            "name": "Debug Vision (macOS leia, LLDB)",
            "type": "node-terminal",
            "request": "launch",
            "command": "exec \"${workspaceFolder}/scripts/macos/remote/debug.sh\"",
            "cwd": "${workspaceFolder}",
            "preLaunchTask": "Build Vision Debug (macOS leia)"
        }
    ]
}
