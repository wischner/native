{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "CMake Configure Debug (Docker Targets)",
            "type": "shell",
            "command": "cmake",
            "args": [
                "-S",
                ".",
                "-B",
                "build/cmake",
                "-G",
                "Unix Makefiles",
                "-DCMAKE_BUILD_TYPE=Debug"
            ],
            "problemMatcher": [],
            "group": "build"
        },
        {
            "label": "CMake Build SDK (Docker GEM v1.0.0)",
            "type": "shell",
            "command": "cmake",
            "args": ["--build", "build/cmake", "--target", "docker-gemix-sdk"],
            "problemMatcher": [],
            "group": "build",
            "dependsOn": "CMake Configure Debug (Docker Targets)"
        },
        {
            "label": "CMake Build Debug (Docker GEMix)",
            "type": "shell",
            "command": "cmake",
            "args": ["--build", "build/cmake", "--target", "docker-gemix"],
            "problemMatcher": "$gcc",
            "group": "build",
            "dependsOn": "CMake Configure Debug (Docker Targets)"
        },
        {
            "label": "CMake Build Debug (Docker GEMix gemd)",
            "type": "shell",
            "command": "cmake",
            "args": ["--build", "build/cmake", "--target", "docker-gemix-gemd"],
            "problemMatcher": "$gcc",
            "group": "build",
            "dependsOn": "CMake Configure Debug (Docker Targets)"
        },
        {
            "label": "CMake Build Debug (Docker X11)",
            "type": "shell",
            "command": "cmake",
            "args": ["--build", "build/cmake", "--target", "docker-x11"],
            "problemMatcher": "$gcc",
            "group": "build",
            "dependsOn": "CMake Configure Debug (Docker Targets)"
        },
        {
            "label": "CMake Build Debug (Docker SDL2)",
            "type": "shell",
            "command": "cmake",
            "args": ["--build", "build/cmake", "--target", "docker-sdl2"],
            "problemMatcher": "$gcc",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "dependsOn": "CMake Configure Debug (Docker Targets)"
        },
        {
            "label": "CMake Build Debug (Docker OpenMotif)",
            "type": "shell",
            "command": "cmake",
            "args": [
                "--build",
                "build/cmake",
                "--target",
                "docker-openmotif"
            ],
            "problemMatcher": "$gcc",
            "group": "build",
            "dependsOn": "CMake Configure Debug (Docker Targets)"
        },
        {
            "label": "CMake Build Debug (Docker OpenLook)",
            "type": "shell",
            "command": "cmake",
            "args": [
                "--build",
                "build/cmake",
                "--target",
                "docker-openlook"
            ],
            "problemMatcher": "$gcc",
            "group": "build",
            "dependsOn": "CMake Configure Debug (Docker Targets)"
        },
        {
            "label": "CMake Build Debug (Docker Window Maker)",
            "type": "shell",
            "command": "cmake",
            "args": [
                "--build",
                "build/cmake",
                "--target",
                "docker-wmaker"
            ],
            "problemMatcher": "$gcc",
            "group": "build",
            "dependsOn": "CMake Configure Debug (Docker Targets)"
        },
        {
            "label": "CMake Build Debug (Docker Windows)",
            "type": "shell",
            "command": "cmake",
            "args": ["--build", "build/cmake", "--target", "docker-win"],
            "problemMatcher": "$gcc",
            "group": "build",
            "dependsOn": "CMake Configure Debug (Docker Targets)"
        },
        {
            "label": "CMake Build Debug (Docker Haiku)",
            "type": "shell",
            "command": "cmake",
            "args": ["--build", "build/cmake", "--target", "docker-haiku"],
            "problemMatcher": "$gcc",
            "group": "build",
            "dependsOn": "CMake Configure Debug (Docker Targets)"
        },
        {
            "label": "Deploy Vision Debug (Windows VM)",
            "type": "process",
            "command": "/bin/bash",
            "args": ["${workspaceFolder}/scripts/windows/vm/prepare.sh"],
            "problemMatcher": [],
            "dependsOn": "CMake Build Debug (Docker Windows)"
        },
        {
            "label": "Stop Vision Debug (Windows VM)",
            "type": "process",
            "command": "/bin/bash",
            "args": ["${workspaceFolder}/scripts/windows/vm/stop.sh"],
            "problemMatcher": []
        },
        {
            "label": "Start Debug Target (Tribblix CDE)",
            "type": "process",
            "command": "${workspaceFolder}/scripts/kvm/ensure-running.sh",
            "args": ["Tribblix-CDE", "tomaz@charlie"],
            "problemMatcher": []
        },
        {
            "label": "Sync Source (OpenMotif Tribblix CDE)",
            "type": "shell",
            "command": "rsync",
            "args": [
                "-az",
                "--delete",
                "--exclude",
                ".git",
                "--exclude",
                "build",
                "${workspaceFolder}/",
                "tomaz@charlie:~/Projects/${workspaceFolderBasename}/"
            ],
            "problemMatcher": [],
            "dependsOn": "Start Debug Target (Tribblix CDE)"
        },
        {
            "label": "Build Vision Debug (OpenMotif Tribblix CDE)",
            "type": "process",
            "command": "ssh",
            "args": [
                "tomaz@charlie",
                "cd $HOME/Projects/${workspaceFolderBasename} && PKG_CONFIG_PATH=/usr/lib/amd64/pkgconfig cmake -S . -B build/tribblix-openmotif-debug -DCMAKE_BUILD_TYPE=Debug -DTOOLKIT=MOTIF -DNATIVE_ENABLE_DEVELOPER_CHECKS=OFF -DCMAKE_CXX_FLAGS='-m64 -Wall -Wextra -pedantic' -DCMAKE_EXE_LINKER_FLAGS=-m64 -DCMAKE_LIBRARY_PATH=/usr/lib/amd64 && cmake --build build/tribblix-openmotif-debug"
            ],
            "problemMatcher": "$gcc",
            "dependsOn": "Sync Source (OpenMotif Tribblix CDE)"
        },
        {
            "label": "Start Debug Target (Tribblix OPEN LOOK)",
            "type": "process",
            "command": "${workspaceFolder}/scripts/kvm/ensure-running.sh",
            "args": ["Tribblix-OpenLook", "tomaz@192.168.122.28"],
            "problemMatcher": []
        },
        {
            "label": "Sync Source (OPEN LOOK Tribblix VM)",
            "type": "shell",
            "command": "rsync",
            "args": [
                "-az",
                "--delete",
                "--exclude",
                ".git",
                "--exclude",
                "build",
                "${workspaceFolder}/",
                "tomaz@192.168.122.28:~/Projects/${workspaceFolderBasename}/"
            ],
            "problemMatcher": [],
            "dependsOn": "Start Debug Target (Tribblix OPEN LOOK)"
        },
        {
            "label": "Build Vision Debug (OPEN LOOK Tribblix VM)",
            "type": "process",
            "command": "ssh",
            "args": [
                "tomaz@192.168.122.28",
                "cd $HOME/Projects/${workspaceFolderBasename} && cmake -S . -B build/tribblix-openlook-debug -DCMAKE_BUILD_TYPE=Debug -DTOOLKIT=OPENLOOK -DNATIVE_ENABLE_DEVELOPER_CHECKS=OFF -DCMAKE_CXX_FLAGS='-m32 -Wall -Wextra -pedantic' -DCMAKE_EXE_LINKER_FLAGS=-m32 -DCMAKE_LIBRARY_PATH=/usr/lib && cmake --build build/tribblix-openlook-debug"
            ],
            "problemMatcher": "$gcc",
            "dependsOn": "Sync Source (OPEN LOOK Tribblix VM)"
        },
        {
            "label": "Start Debug Target (Bookworm Window Maker)",
            "type": "process",
            "command": "${workspaceFolder}/scripts/kvm/ensure-running.sh",
            "args": ["Bookworm-WindowMaker", "whiskey"],
            "problemMatcher": []
        },
        {
            "label": "Prepare Source Directory (Window Maker Bookworm VM)",
            "type": "process",
            "command": "ssh",
            "args": [
                "whiskey",
                "mkdir -p $HOME/Projects/${workspaceFolderBasename}"
            ],
            "problemMatcher": [],
            "dependsOn": "Start Debug Target (Bookworm Window Maker)"
        },
        {
            "label": "Sync Source (Window Maker Bookworm VM)",
            "type": "shell",
            "command": "rsync",
            "args": [
                "-az",
                "--delete",
                "--exclude",
                ".git",
                "--exclude",
                "build",
                "${workspaceFolder}/",
                "whiskey:~/Projects/${workspaceFolderBasename}/"
            ],
            "problemMatcher": [],
            "dependsOn": "Prepare Source Directory (Window Maker Bookworm VM)"
        },
        {
            "label": "Build Vision Debug (Window Maker Bookworm VM)",
            "type": "process",
            "command": "ssh",
            "args": [
                "whiskey",
                "cd $HOME/Projects/${workspaceFolderBasename} && cmake -S . -B build/bookworm-wmaker-debug -DCMAKE_BUILD_TYPE=Debug -DTOOLKIT=WMAKER && cmake --build build/bookworm-wmaker-debug"
            ],
            "problemMatcher": "$gcc",
            "dependsOn": "Sync Source (Window Maker Bookworm VM)"
        },
        {
            "label": "Start Debug Target (Haiku)",
            "type": "process",
            "command": "${workspaceFolder}/scripts/kvm/ensure-running.sh",
            "args": ["Haiku", "user@192.168.122.90"],
            "problemMatcher": []
        },
        {
            "label": "Prepare Vision Debug Directory (Haiku)",
            "type": "shell",
            "command": "ssh",
            "args": [
                "user@192.168.122.90",
                "mkdir -p /boot/home/Projects/${workspaceFolderBasename}/run"
            ],
            "problemMatcher": [],
            "dependsOn": "Start Debug Target (Haiku)"
        },
        {
            "label": "Deploy Vision Debug (Haiku)",
            "type": "shell",
            "command": "scp",
            "args": [
                "${workspaceFolder}/build/haiku/src/vision",
                "user@192.168.122.90:/boot/home/Projects/${workspaceFolderBasename}/run/vision"
            ],
            "problemMatcher": [],
            "dependsOrder": "sequence",
            "dependsOn": [
                "CMake Build Debug (Docker Haiku)",
                "Prepare Vision Debug Directory (Haiku)"
            ]
        },
        {
            "label": "Build Vision Debug (macOS leia)",
            "type": "process",
            "command": "${workspaceFolder}/scripts/macos/remote/build.sh",
            "problemMatcher": "$gcc"
        },
        {
            "label": "Smoke Test Vision Debug (macOS leia)",
            "type": "process",
            "command": "${workspaceFolder}/scripts/macos/remote/smoke-test.sh",
            "problemMatcher": [],
            "dependsOn": "Build Vision Debug (macOS leia)"
        }
    ]
}
