+/* OPEN LOOK desktop separators occupy half an OLGX button and have no ink.
+ * Keep sizing, painting offsets and hit testing on the same row geometry.
+ * In a multi-column menu a row keeps its normal height if any cell needs it.
+ */
+static int
+is_blank_separator(Xv_menu_item_info *item)
+{
+    if (!item || !item->inactive || !item->no_feedback || item->title ||
+        item->image.svr_im)
+        return FALSE;
+#ifdef OW_I18N
+    _xv_use_pswcs_value_nodup(&item->image.string);
+    const wchar_t *text = item->image.string.pswcs.value;
+#else
+    const char *text = item->image.string;
+#endif
+    if (!text) return FALSE;
+    while (*text == ' ' || *text == '\t') ++text;
+    return *text == 0;
+}
+
+static int
+layout_row_height(Xv_menu_info *menu, int row, int rows, int columns,
+                  int normal_height)
+{
+    int column, index, populated = FALSE;
+    int title = menu->nitems && menu->item_list[0]->title;
+    if (title && row == 0) return normal_height;
+    for (column = 0; column < columns; ++column) {
+        if (menu->column_major)
+            index = title && column > 0
+                ? rows + (column - 1) * (rows - 1) + row - 1
+                : column * rows + row;
+        else
+            index = title ? 1 + (row - 1) * columns + column
+                          : row * columns + column;
+        if (index >= menu->nitems) continue;
+        populated = TRUE;
+        if (!is_blank_separator(menu->item_list[index])) return normal_height;
+    }
+    return populated ? imax(1, Button_Height(menu->ginfo) / 2) : normal_height;
+}
+
+static int
+layout_height(Xv_menu_info *menu, int rows, int columns, int normal_height)
+{
+    int row, height = 0;
+    for (row = 0; row < rows; ++row)
+        height += layout_row_height(menu, row, rows, columns, normal_height);
+    return height;
+}
+
+static int
+row_height(Xv_menu_info *menu, int row)
+{
+    return layout_row_height(menu, row, menu->nrows, menu->ncols,
+                             menu->default_image.height);
+}
+
+static int
+row_offset(Xv_menu_info *menu, int row)
+{
+    int current, offset = 0;
+    for (current = 0; current < row; ++current)
+        offset += row_height(menu, current);
+    return offset;
+}
 
